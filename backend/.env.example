# Copy this file to .env and adjust values for your local machine.
# .env is gitignored — never commit real credentials.

APP_NAME="Client Onboarding OS API"
ENVIRONMENT=development
DEBUG=true

# Not used yet (no tables exist until Phase 1), but wired up so Phase 1
# can start running migrations against it immediately.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/onboarding_os

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
